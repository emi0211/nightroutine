
<%= form_for(@perfume, class: 'form-horizontal', role: 'form') do |f| %>
    <!-- app/views/perfumes/new.html.erb -->
<div class="diagnosis-container">

 <div class="diagnosis-title"
   <p>夜の過ごし方診断</p>
 </div>

  <div class="question-block q1">
    <%= image_tag "night_sky1.jpg", class: "question-bg" %>

    <p class="question-text">Q1. 今の気分に一番近いのは？</p>
    <div class="options">
      
      <%= f.radio_button :question1, "1", id: "custom_id1" %>
            <label for="custom_id1">疲れた…</label>

     <%= f.radio_button :question1, "2", id: "custom_id1" %>
            <label for="custom_id1">まだまだ元気！</label>
    
    </div>
  </div>

  <div class="question-block q2">
    <%= image_tag "night_sky2.jpg", class: "question-bg" %>

    <p class="question-text">Q2. 一人で過ごす時間は好き?</p>
    <div class="options">
     <%= f.radio_button :question2, "1", id: "custom_id2" %>
            <label for="custom_id2">はい</label>
      <%= f.radio_button :question2, "2", id: "custom_id2" %>
            <label for="custom_id2">いいえ</label>
    </div>
  </div>

  <div class="question-block q3">
    <%= image_tag "night_sky3.jpg", class: "question-bg" %>

    <p class="question-text">Q3. 明日の予定は？</p>
    <div class="options">
         <%= f.radio_button :question3, "1", id: "custom_id3" %>
            <label for="custom_id3">朝から忙しい…</label>
      <%= f.radio_button :question3, "2", id: "custom_id3" %>
            <label for="custom_id3">ゆっくりできそう！</label>
      
    </div>
  </div>

  <div class="question-block q4">
    <%= image_tag "night_sky4.jpg", class: "question-bg" %>

    <p class="question-text">Q4. 今日の理想の夜は？</p>
    <div class="options">
      <%= f.radio_button :question4, "1", id: "custom_id4" %>
            <label for="custom_id4">静かに落ち着いて過ごしたい</label>
      <%= f.radio_button :question4, "2", id: "custom_id4" %>
            <label for="custom_id4">ちょっと特別な気分で過ごしたい</label>
     
    </div>
  </div>

  <!-- Q2, Q3, Q4 も同様にブロックで分けて書く -->

  <%= submit_tag "結果", class: "submit-button" %>

</div>

<% end %>